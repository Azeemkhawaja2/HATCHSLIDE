<?xml version="1.0" encoding="utf-8"?>
<!-- Progress, settings and stats live in DataStore files; back them up and move them to new devices. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="datastore/" />
    </device-transfer>
</data-extraction-rules>
