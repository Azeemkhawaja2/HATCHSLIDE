# Copy to keystore.properties (git-ignored) or set the matching environment variables:
#   HATCHSLIDE_UPLOAD_STORE_FILE, HATCHSLIDE_UPLOAD_STORE_PASSWORD,
#   HATCHSLIDE_UPLOAD_KEY_ALIAS, HATCHSLIDE_UPLOAD_KEY_PASSWORD
# This is the Play *upload* key. Google Play App Signing holds the app signing key.
storeFile=upload-keystore.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
